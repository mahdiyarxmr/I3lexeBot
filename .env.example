# i3l.exe Telegram bot — environment template.
# Copy to `.env` for local development and fill in real values.
# Never commit a real `.env` file or any secrets.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Numeric owner/user id (original value: 6341879634)
OWNER_ID=6341879634

# PostgreSQL connection string (Neon or another Vercel-compatible provider)
DATABASE_URL=

# Random secret token used for the Telegram webhook.
# Must match the secret_token passed to setWebhook.
WEBHOOK_SECRET=

# Full deployed webhook URL (used by scripts/register_webhook.py)
WEBHOOK_URL=https://YOUR-VERCEL-DOMAIN/api/webhook

# Optional pool tuning
DB_POOL_MAX=4
DB_POOL_MIN=1
DB_POOL_TIMEOUT=10

# Optional local dev server settings
PORT=8000
HOST=0.0.0.0
